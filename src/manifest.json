{
  "manifest_version": 3,
  "name": "Local Bergamot Translator",
  "version": "2.7.4",
  "description": "Locally translates Dutch content to English across configured sites, translates drafts English to Dutch, speaks Dutch with bundled Piper neural TTS, and provides aggregated popup history for Dutch study prompts.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chat.revspace.nl/*",
    "https://forum.revspace.nl/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Local Bergamot Translator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.revspace.nl/*",
        "https://forum.revspace.nl/*"
      ],
      "js": [
        "vendor/notyf/notyf.min.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "css": [
        "vendor/notyf/notyf.min.css"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "config.json",
        "engine-host.html"
      ],
      "matches": [
        "https://chat.revspace.nl/*",
        "https://forum.revspace.nl/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "revtranslator@revspace.nl",
      "strict_min_version": "121.0"
    }
  }
}
